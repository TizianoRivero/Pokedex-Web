<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Pokedex_Web.Site" %>

<!DOCTYPE html>

<html>
<head runat="server">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link href="Content/bootstrap.min.css" rel="stylesheet" />
    <script src="Scripts/bootstrap.min.js"></script>
</head>
<body>

    <form id="form1" runat="server">
        <asp:ScriptManager runat="server" ID="ScriptManager1" />
       <div>

           <nav class="navbar navbar-expand-lg bg-dark navbar-dark">
               <div class="container-fluid">
                   <a class="navbar-brand" href="Default.aspx">Pokedex</a>
                   <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                       <span class="navbar-toggler-icon"></span>
                   </button>
                   <div class="collapse navbar-collapse" id="navbarNav">
                       <ul class="navbar-nav">
                           <li class="nav-item">
                               <a class="nav-link active" aria-current="page" href="Default.aspx">Home</a>
                           </li>
                           <li class="nav-item">
                               <a class="nav-link" href="ListarPokemon.aspx">Lista</a>
                           </li>
                           <li class="nav-item">
                               <a class="nav-link" href="Favoritos.aspx">Favoritos</a>
                           </li>
                           <li class="nav-item">
                               <a class="nav-link" href="MiPerfil.aspx">Mi Perfil</a>
                           </li>
                       </ul>
                       
                   </div>

                   <button type="button" class="btn btn-outline-primary">Login</button>
                   <button type="button" class="btn btn-outline-success" href="Registro.aspx">Registrarse</button>
                   
               </div>
                
           </nav>

            <div class="container">
                <hr />
                <div>
                   <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                   </asp:ContentPlaceHolder>
                </div>
            </div>

       </div>

    </form>

</body>
</html>
